# Examples only. These placeholders are not credentials.
# Compose reads .env; the ragparity CLI reads exported environment variables only.
RAGPARITY_DB_PASSWORD=replace-with-a-local-random-password
RAGPARITY_DB_PORT=55432
RAGPARITY_DATABASE_URL=postgresql+psycopg://ragparity_reader:replace-with-url-encoded-password@127.0.0.1:55432/ragparity
